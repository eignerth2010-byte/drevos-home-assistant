{
  "expo": {
    "name": "Drevos",
    "slug": "drevos-mobile",
    "version": "0.1.0",
    "scheme": "drevos",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101315",
    "ios": {
      "bundleIdentifier": "at.eignerth.drevos",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Drevos verbindet sich mit deinem Home Assistant im lokalen Netzwerk.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "at.eignerth.drevos",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "icon": "./assets/app-icon.png"
  }
}
